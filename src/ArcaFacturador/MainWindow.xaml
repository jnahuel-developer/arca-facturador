<Window x:Class="ArcaFacturador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Facturador ARCA"
        Height="640"
        Width="900"
        MinHeight="580"
        MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937" />
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="150" />
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <Border Margin="28"
                Padding="28"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,24">
                    <TextBlock Text="Facturador ARCA"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="14"
                               Foreground="#6B7280"
                               Text="Emisión local simulada. Todavía no se conecta con ARCA ni genera PDF." />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource LabelText}"
                                   Text="Importe" />
                        <TextBox Height="36"
                                 Padding="10,7"
                                 FontSize="15"
                                 Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Margin="0,18,0,0"
                                    Orientation="Horizontal">
                            <Button Click="ValidateButton_Click"
                                    Content="Validar importe" />
                            <Button Click="SaveButton_Click"
                                    Content="Guardar local" />
                        </StackPanel>

                        <TextBlock Margin="0,22,0,0"
                                   FontSize="13"
                                   Foreground="#B91C1C"
                                   Text="{Binding ValidationMessage}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="13"
                                   Foreground="#047857"
                                   Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="Comprobante" />
                            <TextBlock Style="{StaticResource ValueText}"
                                       Text="{Binding ReceiptType}" />

                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="Cliente" />
                            <TextBlock Style="{StaticResource ValueText}"
                                       Text="{Binding CustomerType}" />

                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="Medio de pago" />
                            <TextBlock Style="{StaticResource ValueText}"
                                       Text="{Binding PaymentMethod}" />

                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="Concepto" />
                            <TextBlock Style="{StaticResource ValueText}"
                                       Text="{Binding Concept}" />

                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="Importe validado" />
                            <TextBlock Style="{StaticResource ValueText}"
                                       Text="{Binding AmountPreview, TargetNullValue=Pendiente}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="Producto local" />
                            <TextBlock Style="{StaticResource ValueText}"
                                       Text="{Binding ProductSummary}" />

                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="Cantidad" />
                            <TextBlock Style="{StaticResource ValueText}"
                                       Text="{Binding QuantitySummary}" />

                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="Fecha de emisión" />
                            <TextBlock Style="{StaticResource ValueText}"
                                       Text="{Binding IssueDateText}" />

                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="Servicio desde" />
                            <TextBlock Style="{StaticResource ValueText}"
                                       Text="{Binding ServiceFromText}" />

                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="Servicio hasta" />
                            <TextBlock Style="{StaticResource ValueText}"
                                       Text="{Binding ServiceToText}" />

                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="Vencimiento de pago" />
                            <TextBlock Style="{StaticResource ValueText}"
                                       Text="{Binding PaymentDueDateText}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <TextBlock Grid.Row="2"
                           Margin="0,24,0,0"
                           FontSize="12"
                           Foreground="#6B7280"
                           Text="Los comprobantes guardados en esta etapa quedan pendientes de autorización. La emisión fiscal se implementará en módulos posteriores."
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Window>
